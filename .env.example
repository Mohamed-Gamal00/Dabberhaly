APP_NAME=Dabberhaly
# Production-safe defaults: this file is copied verbatim for a new deploy,
# so it must never enable debug mode or point at dev services.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
TELESCOPE_ENABLED=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dabberhaly
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# database = newsletter (and other queued notifications) are sent in the
# background by `php artisan queue:work`. Do not use sync in production,
# or the admin request will wait for every mail to be sent.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Required in production: the session cookie must only be sent over HTTPS.
SESSION_SECURE_COOKIE=true

# CORS — comma-separated list of origins allowed to call the API from a
# browser (the native mobile app is not affected by CORS). Defaults to APP_URL.
CORS_ALLOWED_ORIGINS=https://dabberhaly.com

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — production needs a real SMTP provider (Mailgun, Postmark, SES or
# any SMTP service). Pick one and fill in its credentials below.
# mailpit is a local development tool ONLY and must never be used in
# production, or no order / newsletter / password-reset email will be sent.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Admin account created by AdminSeeder on a fresh seed.
# ADMIN_EMAIL is optional (defaults to admin@dabberhaly.com). If
# ADMIN_PASSWORD is not set, the seeder generates a random password and
# prints it ONCE to the console — there is no default password.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# NOTE: there are intentionally NO Moyasar / SMS variables here. No code
# reads MOYASAR_* or SMS_* from the environment — the real keys live in the
# `settings` table and are managed from /admin/front_settings. The
# SettingsSeeder only copies them from the environment at seed time if
# they happen to be set; do not rely on .env for payments or SMS.
